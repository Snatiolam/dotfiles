# ==========================================
# Ghostty Configuration
# ==========================================

theme = light:TokyoNight Day, dark:TokyoNight Storm

font-family = MonaspiceNe Nerd Font
font-family = monospace
font-size = 14

window-padding-x = 12
window-padding-y = 12
window-decoration = true
gtk-titlebar = false

mouse-hide-while-typing = true
copy-on-select = clipboard
cursor-style-blink = false

keybind = ctrl+shift+d=toggle_window_decorations

keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
